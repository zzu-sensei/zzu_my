# ---- 网页登录会话 ----
# 至少 32 字节的随机字符串；未配置时 Vercel 上会拒绝登录。
ZZU_WEB_SESSION_SECRET=请替换为至少32字节的随机字符串

# ---- 电量提醒：发信通道（必填） ----
# 发信服务商：resend 或 brevo。
ZZU_MAIL_PROVIDER=resend
# 服务商控制台生成的 API Key。Resend 形如 re_xxx，Brevo 形如 xkeysib-xxx。
ZZU_MAIL_API_KEY=
# 发信地址，必须是已在该服务商验证过的域名下的地址。
ZZU_MAIL_FROM=alert@example.com
# 发信人显示名。
ZZU_MAIL_FROM_NAME=郑大生活助手
# 收件人，多个用逗号分隔。
ZZU_MAIL_TO=me@example.com

# ---- 电量提醒：可选备用通道 ----
# 主服务商失败（非 4xx 配置类错误）时自动改用备用服务商。
# ZZU_MAIL_FALLBACK_PROVIDER=brevo
# ZZU_MAIL_FALLBACK_API_KEY=

# ---- 电量提醒：阈值与防打扰 ----
# 预警阈值（度），低于或等于该值即提醒。
ZZU_ENERGY_THRESHOLD=2
# 低电量持续多久后补发一次提醒（秒），默认 43200（12 小时）。
# ZZU_ENERGY_COOLDOWN_SECONDS=43200
# 去重状态文件位置。Serverless 上只有 /tmp 可写。
# ZZU_ENERGY_STATE=/tmp/zzu-energy-alert.json
# 设为 1 时只判断不发信，便于试跑。
# ZZU_ALERT_DRY_RUN=1

# ---- 电量提醒：接口保护（必填） ----
# 保护 /api/energy-alert 与 /api/energy-alert/cron 的共享密钥。
# 未配置时这两个接口一律返回 503，避免被匿名调用刷爆邮件额度。
# 生成方式：openssl rand -hex 32
ZZU_ALERT_SECRET=

# ---- 电量提醒：服务端巡检（可选） ----
# 只在让 Vercel 自己查电量时填写。填写后统一认证密码会保存在服务端，
# 不想这样做的请改用 POST /api/energy-alert 由设备上报读数。
# ZZU_ACCOUNT=
# ZZU_PASSWORD=
